rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly(['campaignId','sellerName','rawText','customers','createdAt'])
        && request.resource.data.campaignId is string
        && request.resource.data.sellerName is string
        && request.resource.data.sellerName.size() >= 2
        && request.resource.data.sellerName.size() <= 120
        && request.resource.data.rawText is string
        && request.resource.data.rawText.size() <= 50000
        && request.resource.data.customers is list
        && request.resource.data.customers.size() > 0
        && request.resource.data.customers.size() <= 300
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.isActive == true;
      allow read, delete: if signedIn();
      allow update: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
